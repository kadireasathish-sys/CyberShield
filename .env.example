# Copy to your deployment environment; do not commit real values.
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/cybershield?useSSL=true&serverTimezone=UTC
DB_USERNAME=cybershield
DB_PASSWORD=replace-with-a-strong-secret
APP_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
APP_JWT_EXPIRATION_MS=3600000
APP_UPLOAD_DIR=/var/lib/cybershield/evidence
APP_CORS_ALLOWED_ORIGINS=https://your-approved-ui.example
APP_DEMO_SEED_ENABLED=false
